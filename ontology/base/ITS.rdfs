        <dc:date>April 20, 2012</dc:date>
        <dc:creator>Derlis Gregor &lt;derlis.gregor@gmail.com&gt;</dc:creator>
        <dc:description>The ITS.owl ontology was created using automatic techniques proposed in the paper &quot;Structured ontology construction based on intelligent transportation systems&quot;. For more information see http://edsplab.us.es/ITSresearch</dc:description>
        <dc:title>Intelligent Transportation Systems</dc:title>
        <dc:rights> Copyright &#169; 2012 - URBALAN - edsplab.us.es</dc:rights>
    </Ontology>
    


